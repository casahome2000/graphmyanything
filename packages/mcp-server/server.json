{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.casahome2000/graphmyanything-mcp",
  "title": "GraphMyAnything",
  "description": "Build once, ask forever. Chart & metric memory for AI agents: track, query, insight, forget, chart.",
  "websiteUrl": "https://graphmyanything.com",
  "repository": {
    "url": "https://github.com/casahome2000/graphmyanything",
    "source": "github",
    "subfolder": "packages/mcp-server"
  },
  "version": "0.2.11",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "graphmyanything-mcp",
      "version": "0.2.11",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GRAPHMYANYTHING_DB_PATH",
          "description": "Optional SQLite path (default ~/.graphmyanything/metrics.db)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GRAPHMYANYTHING_CHARTS_DIR",
          "description": "Optional chart SVG output directory (default: charts/ beside DB, or ~/.graphmyanything/charts/)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GRAPHMYANYTHING_API_KEY",
          "description": "Optional hosted API key (Bearer). Use after sync or from your account.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "GMA_API_KEY",
          "description": "Alias for GRAPHMYANYTHING_API_KEY",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}