{
  "name": "graphmyanything-mcp",
  "version": "0.2.1",
  "description": "Metric memory for AI agents: track, query, chart via MCP — one call vs throwaway Python",
  "homepage": "https://graphmyanything.com",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.casahome2000/graphmyanything-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metrics",
    "charts",
    "ai-agents",
    "time-series"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casahome2000/graphmyanything.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/casahome2000/graphmyanything/issues"
  },
  "bin": {
    "graphmyanything-mcp": "bin/graphmyanything-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "docs:chart-samples": "npm run build && node scripts/render-sample-charts.mjs",
    "prepack": "npm run build --prefix ../core && npm run build && node scripts/prepack-manifest.mjs",
    "postpack": "node scripts/postpack-manifest.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@graphmyanything/core": "file:../core",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "bundleDependencies": [
    "@graphmyanything/core"
  ]
}
